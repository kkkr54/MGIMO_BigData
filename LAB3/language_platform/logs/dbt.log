    join "language_db"."main"."languages" l on les.lang_id = l.lang_id
)

select 
    user_name,
    language,
    count(lesson_title) as lessons_attempted,
    avg(score) as avg_score,
    -- добавим логику: прошел ли курс (если средний балл > 70)
    case 
        when avg(score) >= 70 then 'Passed'
        else 'Needs Practice'
    end as qualification
from source_data
group by 1, 2
    );
  
  
