    as (
      

with source_data as (
    select
        u.user_name,
        u.country,
        l.lang_name as language,
        les.lesson_title,
        p.score,
        p.status
    from "language_db"."main"."progress" p
    join "language_db"."main"."users" u on p.user_id = u.user_id
    join "language_db"."main"."lessons" les on p.lesson_id = les.lesson_id
    join "language_db"."main"."languages" l on les.lang_id = l.lang_id
)

select 
    user_name,
    language,
    count(lesson_title) as lessons_attempted,
    avg(score) as avg_score,
    -- добавим логику: прошел ли курс (если средний балл > 70)
    case 
        when avg(score) >= 70 then 'Passed'
        else 'Needs Practice'
    end as qualification
from source_data
group by 1, 2
    );
  
  
